# Runtime local
NODE_ENV=development
PORT=4000
FRONTEND_DEV_ORIGIN=http://localhost:5173

# SQLite
# Local recomendado:
DATABASE_URL=file:./dev.db
# Railway/Docker con volumen:
# DATABASE_URL=file:/data/kpi.db
# DATABASE_PATH=/data/kpi.db

# Auth
JWT_SECRET=
COOKIE_NAME=kpi_access
REFRESH_COOKIE_NAME=kpi_refresh
SYNC_API_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# Seed local opcional
SEED_ADMIN_EMAIL=admin@mbc.local
SEED_ADMIN_PASSWORD=
BOOTSTRAP_SEED=false

# KPI source
# Opciones: disabled | local | onedrive | googledrive
KPI_SOURCE=local
KPI_LOCAL_FILE_PATH=
KPI_SYNC_INTERVAL_MS=1800000
KPI_SYNC_STABILITY_DELAY_MS=5000
KPI_SYNC_STARTUP=true

# Google Drive
GOOGLE_DRIVE_FILE_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Microsoft Graph / OneDrive / SharePoint
# Completar cuando exista la app real de Microsoft Entra.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Preferido si se tiene identificador estable del archivo:
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ITEM_ID=

# Alternativa por usuario + ruta:
ONEDRIVE_USER_ID=
ONEDRIVE_FILE_PATH=/KPI_JEFATURAS/kpis.csv

# Sync-agent local legacy opcional
WATCH_PATH=
API_URL=http://localhost:4000
CHECK_INTERVAL_MS=60000
